# Virtual environments, any name. `.venv/` is this project's; the pattern is broader because
# `[VERIFIED]` 2026-08-26 a 4.6 MB `.tangovenv/` from a different project was sitting here
# untracked and unignored, one `git add -A` away from being committed into a repository meant
# to be published.
.venv/
*venv/
__pycache__/
*.pyc
.env
*.db
.pytest_cache/
.ruff_cache/
.coverage
*.egg-info/
build/
.claude/settings.local.json
.claude/worktrees/
*.bkp
logs/
# Recorded batches. Local reproduction assets, not repository content: feed text is the
# C3 exposure ADR-009 avoids, and this grows with every run. Promote a specific batch into
# tests/fixtures/ when a task cites it.
evidence/
