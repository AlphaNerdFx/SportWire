# Core Environment Execution Flags
APP_ENV=development
DEBUG=true
POLLING_INTERVAL_SECONDS=28800

# Persistent Storage Target
DATABASE_URL=sqlite:///./database/openclaw_state.db

# Scraper Integration Tokens
APIFY_API_TOKEN=your_apify_token_here

# Meta / WhatsApp Business Gateway Variables
META_WHATSAPP_API_TOKEN=your_meta_system_user_token_here
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=your_phone_id_here
TARGET_RECIPIENT_PHONE_NUMBER=your_personal_or_broadcast_number_here

# Synthesis Layer Keys
OPENAI_API_KEY=your_openai_key_here
LLM_MODEL_NAME=gpt-4o-mini