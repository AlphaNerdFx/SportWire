# Committed placeholder file. Copy to .env and fill in real values; .env is gitignored.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BALL_DONT_LIE_API_KEY=
# Where the SQLite file lives. Optional: left empty it is `sportwire.db` at the project root.
# A relative path is anchored to the project root on purpose, because a bare name resolved
# against the working directory would give a scheduled run its own database in $HOME and
# split the dedup state in two. An absolute path is honoured as given.
#
# `[VERIFIED]` 2026-09-05: this said `DATABASE_URL=sqlite:///sportwire.db` until today, which
# nothing has ever read. Setting it did nothing at all, silently.
DATABASE_PATH=
LOG_LEVEL=INFO
# How often the scheduler invokes main.py. The summary covers whatever is new since the
# previous run, so this value alone defines the reporting window (PRD D1).
POLL_INTERVAL_HOURS=8

# How long a delivered item is remembered so it is never re-sent. Must exceed how far back
# the news feed reaches, NOT the poll interval: ESPN lists items up to ~4 days old, so a
# shorter window makes an already-sent story look new again on every run (PRD D2).
DEDUP_WINDOW_HOURS=168

# Which local models write the brief, smallest first. OLLAMA_FIRST_MODEL writes every brief;
# OLLAMA_MODEL is loaded only when the validator refuses what the first one wrote.
#
# The default ladder is for a machine that is short of memory. [VERIFIED] 2026-08-27 on the
# operator's WSL2 setup, 7.4 GB of RAM total with 5.3 GB free: running mistral:7b (4.4 GB) for
# every brief stalled the whole desktop, while llama3.2:3b (2.0 GB) writes most briefs and
# leaves over 5 GB free. Set both to the same name to turn the ladder off and always use the
# capable model, which is what a machine with room to spare should do.
OLLAMA_FIRST_MODEL=llama3.2:3b
OLLAMA_MODEL=mistral:7b

# Optional. Set this and the brief is written by a hosted model instead of the local one.
# The key alone is the switch: there is no second flag to turn it on.
#
# [VERIFIED] 2026-08-27 this was missing from this file while config/settings.py already read
# it, so the only way to discover the setting existed was to read the source. Get a key from
# openrouter.ai; the default model below is a free tier one, so this costs nothing to try.
# Leave it empty to keep using Ollama on this machine.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# --- deferred, do not populate until the slice that needs it (see TASKS.md) ---
APIFY_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
